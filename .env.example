# ---------- Application ----------
APP_PORT=5001
APP_HOST_URL="http://localhost:5001"
APP_DEBUG=true

# ---------- Base de données (MySQL) ----------
# Créez d'abord une base vide :
# CREATE DATABASE skl_db CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DB_HOST="localhost"
DB_USER="root"
DB_PASSWORD=""
DB_DB="skl_db"
DB_DIALECT="mysql"

# ---------- Sécurité ----------
BCRYPT_SALT=10
# Générez chaque secret avec :
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""
PASSWORD_TOKEN_SECRET=""
EMAIL_TOKEN_SECRET=""

# ---------- Envoi de mails (Gmail) ----------
# MAIL_PASSWORD est un "mot de passe d'application" Google
# (validation en deux étapes requise), pas le mot de passe du compte.
MAIL_HOST="smtp.gmail.com"
MAIL_PORT=465
MAIL_USER=""
MAIL_PASSWORD=""
MAIL_FROM="SKULLVI Talent Engine <votre.adresse@gmail.com>"

# ---------- Premier compte recruteur (npm run seed:admin) ----------
# ADMIN_EMAIL doit être une adresse réelle : le code de connexion y est envoyé.
# ADMIN_PASSWORD : 8 à 64 caractères.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""